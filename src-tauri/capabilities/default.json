{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-main",
  "description": "Permisos mínimos para la ventana principal de Transcriptor",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/transcriptor-engine",
          "sidecar": true,
          "args": ["serve"]
        }
      ]
    }
  ]
}
