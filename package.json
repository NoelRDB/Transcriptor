{
  "name": "transcriptor",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "sidecar:install": "uv sync --project sidecar --extra dev",
    "sidecar:test": "uv run --project sidecar pytest",
    "sidecar:lint": "uv run --project sidecar ruff check sidecar/transcriptor_engine sidecar/tests sidecar/launcher.py",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "release:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "check": "npm run lint && npm run test && npm run build && npm run sidecar:lint && npm run sidecar:test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-shell": "2.3.5",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.54.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
